# Solo para verlo en local antes de publicar. GitHub Pages no lee este
# fichero: allí se construye con su propia versión de Jekyll.
#
#   bundle install
#   bundle exec jekyll serve --livereload
#
# La gema `github-pages` fija exactamente las versiones que usa GitHub, para
# que lo que veas en local sea lo que se publica.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"
